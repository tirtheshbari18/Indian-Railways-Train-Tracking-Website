{
  "name": "indian-railways-train-tracking-website",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend && node -e \"const fs=require('fs'); if(fs.existsSync('frontend/dist')){fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('frontend/dist','dist',{recursive:true});}\"",
    "dev": "npm run dev --workspace=frontend",
    "start": "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8000"
  },
  "keywords": [
    "indian-railways",
    "train-tracking",
    "fastapi",
    "react",
    "leaflet",
    "vite"
  ],
  "author": "Tirthesh Bari",
  "license": "MIT"
}
